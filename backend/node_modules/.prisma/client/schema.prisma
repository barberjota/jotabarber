datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Rol {
  ADMIN
  STAFF
  CLIENTE
}

enum EstadoCita {
  PENDIENTE
  CONFIRMADO
  COMPLETADO
  CANCELADO
}

enum TipoRecompensa {
  DESCUENTO_QUINTO_CORTE
  CANJE_PUNTOS
}

model Usuario {
  id                String               @id @default(uuid())
  password          String
  nombre            String
  telefono          String               @unique
  rol               Rol                  @default(CLIENTE)
  saldoPuntos       Int                  @default(0) // Saldo de puntos acumulados
  cortesCompletados Int                  @default(0) // Contador de cortes para el ciclo de 5 cortes
  citas             Cita[]
  ventas            Venta[]
  historialLealtad  HistorialFidelidad[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
}

model Estilista {
  id        String             @id @default(uuid())
  nombre    String
  photoUrl  String?
  isActive  Boolean            @default(true)
  citas     Cita[]
  horarios  HorarioEstilista[]
  createdAt DateTime           @default(now())
}

model HorarioEstilista {
  id          String    @id @default(uuid())
  estilistaId String
  diaSemana   Int // 0 = Domingo, 1 = Lunes, ..., 6 = Sábado
  horaInicio  String // Ej: "09:00"
  horaFin     String // Ej: "19:00"
  estilista   Estilista @relation(fields: [estilistaId], references: [id], onDelete: Cascade)
}

model Servicio {
  id              String  @id @default(uuid())
  nombre          String
  descripcion     String?
  duracionMin     Int // Duración en minutos (ej: 30, 45, 60)
  precio          Decimal @db.Decimal(10, 2)
  aplicaFidelidad Boolean @default(true) // Si este servicio suma al ciclo del 5to corte
  isActive        Boolean @default(true)
  citas           Cita[]
}

model Producto {
  id          String      @id @default(uuid())
  nombre      String
  descripcion String?
  precio      Decimal     @db.Decimal(10, 2)
  costoPuntos Int? // Costo en puntos si se puede canjear
  stock       Int         @default(0)
  imageUrl    String?
  isActive    Boolean     @default(true)
  itemsVenta  ItemVenta[]
}

model Cita {
  id                 String     @id @default(uuid())
  usuarioId          String // Cliente registrado
  estilistaId        String
  servicioId         String
  fechaHora          DateTime
  fechaHoraFin       DateTime
  estado             EstadoCita @default(CONFIRMADO)
  descuentoAplicado  Decimal    @default(0.00) @db.Decimal(10, 2)
  esPromoQuintoCorte Boolean    @default(false) // Indica si se aplicó el beneficio de cliente fiel
  notas              String?
  usuario            Usuario    @relation(fields: [usuarioId], references: [id])
  estilista          Estilista  @relation(fields: [estilistaId], references: [id])
  servicio           Servicio   @relation(fields: [servicioId], references: [id])
  venta              Venta?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
}

model HistorialFidelidad {
  id             String          @id @default(uuid())
  usuarioId      String
  puntos         Int // Positivo al ganar puntos, negativo al canjear
  motivo         String // Ej: "Cita completada", "Compra de cera", etc.
  tipoRecompensa TipoRecompensa?
  usuario        Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  createdAt      DateTime        @default(now())
}

model Venta {
  id            String      @id @default(uuid())
  usuarioId     String?
  citaId        String?     @unique
  subtotal      Decimal     @db.Decimal(10, 2)
  descuento     Decimal     @default(0.00) @db.Decimal(10, 2)
  total         Decimal     @db.Decimal(10, 2)
  puntosGanados Int         @default(0)
  puntosUsados  Int         @default(0)
  usuario       Usuario?    @relation(fields: [usuarioId], references: [id])
  cita          Cita?       @relation(fields: [citaId], references: [id])
  items         ItemVenta[]
  createdAt     DateTime    @default(now())
}

model ItemVenta {
  id         String   @id @default(uuid())
  ventaId    String
  productoId String
  cantidad   Int
  precioUnit Decimal  @db.Decimal(10, 2)
  venta      Venta    @relation(fields: [ventaId], references: [id], onDelete: Cascade)
  producto   Producto @relation(fields: [productoId], references: [id])
}
